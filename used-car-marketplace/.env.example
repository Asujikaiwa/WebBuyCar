# ---- Database ----
# PostgreSQL connection string (เปลี่ยนเป็นของจริงตอน deploy)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/usedcars?schema=public"

# ---- Auth ----
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# OAuth (ตัวอย่าง — ใส่เมื่อพร้อมใช้)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Object storage / Media (S3 หรือ Cloudflare R2) ----
S3_ENDPOINT=""              # R2: https://<account>.r2.cloudflarestorage.com (S3 ปล่อยว่างได้)
S3_REGION="auto"            # AWS S3 ใส่ region เช่น ap-southeast-1; R2 ใช้ auto
S3_BUCKET="usedcars-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE_URL=""        # เช่น https://media.yourdomain.com (โดเมน CDN ที่ชี้ไป bucket)

# ---- Cache / Queue ----
REDIS_URL="redis://localhost:6379"

# ---- Real-time chat (Pusher) ----
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"        # ap1 = Singapore (ใกล้ไทยสุด)
# ค่าฝั่ง client (ต้องขึ้นต้น NEXT_PUBLIC_)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ---- Payments (เลือกผู้ให้บริการ: Stripe สากล / Omise หรือ 2C2P ไทย) ----
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Observability ----
SENTRY_DSN=""
